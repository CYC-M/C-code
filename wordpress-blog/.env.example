# ===== WordPress 环境配置 =====
# 复制此文件为 .env 并填入实际值

# 站点标题
WP_SITE_TITLE="我的个人博客"

# 站点描述
WP_SITE_TAGLINE="记录生活，分享知识"

# 数据库设置
WP_DB_HOST=localhost
WP_DB_NAME=wp_blog_db
WP_DB_USER=root
WP_DB_PASSWORD=your_secure_password_here

# 管理员账号
WP_ADMIN_EMAIL=admin@example.com
WP_ADMIN_USERNAME=administrator
WP_ADMIN_PASSWORD=your_secure_password_here

# URL 配置
WP_SITE_URL=http://localhost:8080
WP_SITE_HTTPS=false

# 通用设置
WP_DEBUG=false
WP_MAX_FILE_SIZE=10M
WP_CACHE_DAYS=7

# 安全密钥（建议使用 wp-config-sample.php 生成强随机密钥）
WP_SALT_1="生成的随机盐值1"
WP_SALT_2="生成的随机盐值2"
WP_SALT_3="生成的随机盐值3"
WP_SALT_4="生成的随机盐值4"
